		  $(RL_LIBDIR)/readline.o \
		  $(RL_LIBDIR)/rltty.o \
		  $(RL_LIBDIR)/savestring.o \
		  $(RL_LIBDIR)/search.o \
		  $(RL_LIBDIR)/shell.o \
