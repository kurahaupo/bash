		  $(RL_LIBSRC)/mbutil.c \
		  $(RL_LIBSRC)/misc.c \
		  $(RL_LIBSRC)/nls.c \
		  $(RL_LIBSRC)/parens.c \
		  $(RL_LIBSRC)/parse-colors.c \
		  $(RL_LIBSRC)/parse-colors.h \
		  $(RL_LIBSRC)/posixstat.h \
		  $(RL_LIBSRC)/readline.c \
		  $(RL_LIBSRC)/readline.h \
		  $(RL_LIBSRC)/rlconf.h \
		  $(RL_LIBSRC)/rldefs.h \
		  $(RL_LIBSRC)/rlshell.h \
		  $(RL_LIBSRC)/rlstdc.h \
		  $(RL_LIBSRC)/rltty.c \
		  $(RL_LIBSRC)/savestring.c \
		  $(RL_LIBSRC)/search.c \
		  $(RL_LIBSRC)/shell.c \
		  $(RL_LIBSRC)/signals.c \
		  $(RL_LIBSRC)/tcap.h \
		  $(RL_LIBSRC)/terminal.c \
		  $(RL_LIBSRC)/text.c \
		  $(RL_LIBSRC)/tilde.c \
		  $(RL_LIBSRC)/tilde.h \
		  $(RL_LIBSRC)/undo.c \
		  $(RL_LIBSRC)/util.c \
		  $(RL_LIBSRC)/vi_keymap.c \
		  $(RL_LIBSRC)/vi_mode.c \
		  $(RL_LIBSRC)/xmalloc.c \
		  ${RL_LIBSRC}/rlprivate.h \
		  ${RL_LIBSRC}/xmalloc.h \


READLINE_OBJ	= \
		  $(RL_LIBDIR)/bind.o \
		  $(RL_LIBDIR)/callback.o \
		  $(RL_LIBDIR)/colors.o \
		  $(RL_LIBDIR)/compat.o \
		  $(RL_LIBDIR)/complete.o \
		  $(RL_LIBDIR)/display.o \
		  $(RL_LIBDIR)/funmap.o \
		  $(RL_LIBDIR)/histexpand.o \
		  $(RL_LIBDIR)/histfile.o \
		  $(RL_LIBDIR)/history.o \
		  $(RL_LIBDIR)/histsearch.o \
		  $(RL_LIBDIR)/input.o \
