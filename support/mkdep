#!/bin/sh
#
# Copyright © 2024 The Free Software Foundation.
#
#

append_depfile=false
compiler=cc
depfile=.depend
keep_output=false
keep_path=false
m_flag=-MM
patch_makefile=
skip_o=false
sort_depfile=false

topdir=
srcdir=
blddir=.

while :
do
  case $1 in
    -a)
      # append to the dependency file (rather than overwriting it)
      append_depfile=true ;;

    -as)
      # append-and-sort, to prevent creating duplicates
      #
      # WARNING: do not use this option unless the existing depfile was
      # generated by this script or otherwise has one dependency pair per line.
      append_depfile=true
      sort_depfile=true ;;

    -s)
      # "sort" without "append" has no effect, since the newly generated
      # dependency list is already sorted
      ;;

    -c)
      # change compiler
      compiler=$2
      shift ;;

    -f)
      # select a dependency file
      depfile=$2
      shift ;;

    -kf)
      # Keep the temporary files on failure
      keep_output=true
      ;;

    -kp)
      # keep PATH from environment
      keep_path=true
      ;;

    -M | -MM)
      # report or ignore system-supplied #include files
      m_flag=$1 ;;

    -p)
      # produce “program: program.c”-style dependencies
      # (to avoid generating .o files)
      skip_o=true ;;

    -P|--patch)
      patch_makefile=Makefile ;;

    --patch=*)
      patch_makefile=${1#*=} ;;

    -P*)
      patch_makefile=${1#??} ;;

    -S)
      srcdir=$2 ; shift ;;

    -T)
      topdir=$2 ; shift ;;

    --)
      # end of mkdep options; compiler options may follow
      shift
      break ;;

    -*)
      echo >&2 "${0##*/}: invalid option '$1'"
      exit 2 ;;

    *)
      # end of mkdep options; compiler options may follow
      break ;;
  esac
  shift
done

if [ $# = 0 ] ; then
  echo >&2 'usage: mkdep [-a] [-c compiler] [-f depend_file] [-p] [--] [cc_flags] file ...'
  exit 2
fi

srcdir=${srcdir:+${srcdir%/}/}  # append / if non-empty and doesn't already have /
topdir=${topdir:+${topdir%/}/}  # append / if non-empty and doesn't already have /
xtopdir=${topdir:+'${topdir}'/}  
blddir=${blddir:+${blddir%/}/}  # append / if non-empty and doesn't already have /

case $srcdir in
  $topdir*) ;;
  '')	    srcdir=$topdir ;;
  *)	    echo >&2 "mkdep: src_dir (-S $srcdir) is not within top_dir (-T $topdir)" ; exit 2
esac

subdir=${srcdir#"$topdir"}      # where is the target dir within the build tree?

tgtdir=$blddir$subdir

if ! "$keep_path"
then
  PATH=/bin:/usr/bin:/usr/local/bin:/opt/bin:$PATH
  export PATH
fi

output=$depfile.mkdep$$

cleanup() {
  rm -f "$output".*
  :
}

if "$keep_output"
then soft_cleanup() { :; }
else soft_cleanup() { cleanup ; }
fi

caught () {
  soft_cleanup
  trap 2	# SIGQUIT
  kill -2 $$
}

trap caught 1 2 3 13 15

"$compiler" "$m_flag" "$@" > "$output.1" || {
  ex=$?
  echo >&2 "mkdep: compilation failed; exit status $ex."
  soft_cleanup
  exit "$ex"
}

# (1) roll up lines ending with \\
# (2) split each dependency pair into a separate line

sed '
    s@ \./@ @g;
    :a
    / \\$/ {
      N
      s/[[:space:]]*\\\n[[:space:]]*/ /
      ta
      s/\\$//
    }
    s/  *$//
    /^[^ ]*:$/d
    :b
    /^[^ :][^ :]*:/ {
      s@^\([^ :][^ :]*: \)\([^ ][^ ]*\) @\1\2\n\1@
      /: \/usr\/include/bd
      /: \/usr\/lib/bd
      P
      :d
      D
      tb
    }
  ' < "$output.1" > "$output.2" &&

# If the real target is a completed executable, create a dependency list
# directly targetting it, rather than the intermediate .o file(s).

if "$skip_o"
then
  sed 's/\.o: /: /' < "$output.2" > "$output.3"
else
  ln "$output.2" "$output.3"
fi &&

# Canonicalize paths changing A/B/C/../../D to A/D

sed '
    :a
    s@^\./@@
    s@ \./@ @g
    s@/\./@/@g
    ta
    :b
    s@^[^/. ][^/ ]*/\.\./@@
    s@ [^/. ][^/ ]*/\.\./@ @g
    s@/[^/. ][^/ ]*/\.\./@/@g
    tb
  ' < "$output.3" > "$output.4" &&

# Sort the generated dependency list to eliminate duplicates

sort -u "$output.4" > "$output.5" &&

# Optionally incorporate the original depfile

if "$append_depfile"
then
  cat "$depfile" "$output.5" > "$output.6"
else
  ln "$output.5" "$output.6"
fi &&

# Optionally sort the entire output (this only makes a difference if
# incorporating the original depfile rather than overwriting it.

if "$sort_depfile"
then
  sort -u "$output.6" > "$output.7"
else
  ln "$output.6" "$output.7"
fi &&

# Rewrite paths as needed
#

while
  IFS= read -r line
do
  case $line in
    '' |\
    '#'* |\
    *': $'* ) echo "$line" ;;
    *': '*)
      s=${line#*': '}
      t=${line%%': '*}
      printf '%s: %s\n' "$subdir$t" "$xtopdir$subdir$s"
      ;;
    * ) echo "$line"
      echo >&2 'Warning: copying unmatched line: '"$line"
      ;;
  esac
done < "$output.7" > "$output.8" &&

# If everything has worked, replace the depfile

mv "$output.8" "$depfile" &&

if [ -n "$patch_makefile" ]
then
  pmt=$patch_makefile.tmp$$
  {
    sed < "$patch_makefile" '/^#* *MKDEP-CUT-HERE/,$ d' && 
    echo '#####   MKDEP-CUT-HERE  #####   Generated dependencies below; DO NOT EDIT  #####' && 
    cat .depend 
  } > "$pmt" && 
  mv "$pmt" "$patch_makefile"
fi &&

cleanup &&

exit 0
