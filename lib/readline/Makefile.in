PACKAGE = @PACKAGE_NAME@
VERSION = @PACKAGE_VERSION@

PACKAGE_BUGREPORT = @PACKAGE_BUGREPORT@
PACKAGE_NAME = @PACKAGE_NAME@
PACKAGE_STRING = @PACKAGE_STRING@
PACKAGE_VERSION = @PACKAGE_VERSION@

srcdir = @srcdir@
VPATH = @srcdir@
topdir = @top_srcdir@

datarootdir = @datarootdir@

INSTALL = @INSTALL@
INSTALL_PROGRAM = @INSTALL_PROGRAM@
INSTALL_DATA = @INSTALL_DATA@

CC = @CC@
RANLIB = @RANLIB@
AR = @AR@
ARFLAGS = @ARFLAGS@
RM = rm -f
CP = cp
MV = mv

SHELL = @MAKE_SHELL@

# Programs to make tags files.
ETAGS = etags -tw
CTAGS = ctags -tw

DEBUG = @DEBUG@

ADDON_CFLAGS =

CFLAGS = @CFLAGS@
LOCAL_CFLAGS = @LOCAL_CFLAGS@ ${DEBUG}
STYLE_CFLAGS = @STYLE_CFLAGS@
CPPFLAGS = @CPPFLAGS@
LDFLAGS = @LDFLAGS@

DEFS = @DEFS@
LOCAL_DEFS = @LOCAL_DEFS@

INCLUDES = -I. \
	   -I../.. \
	   -I$(topdir) \
	   -I$(topdir)/lib \
	   -I$(topdir)/include \


CCFLAGS = $(DEFS) $(LOCAL_DEFS) $(APP_CFLAGS) $(CPPFLAGS) ${INCLUDES} \
	  $(STYLE_CFLAGS) $(LOCAL_CFLAGS) $(CFLAGS) ${ADDON_CFLAGS}

.c.o:
	@- ${RM} $@
	$(CC) -c $(CCFLAGS) $<

# The name of the main library target.
LIBRARY_NAME = libreadline.a

# The C code source files for this library.
CSOURCES	= \
		  $(srcdir)/bind.c \
		  $(srcdir)/callback.c \
		  $(srcdir)/colors.c \
		  $(srcdir)/compat.c \
		  $(srcdir)/complete.c \
		  $(srcdir)/display.c \
		  $(srcdir)/emacs_keymap.c \
		  $(srcdir)/funmap.c \
		  $(srcdir)/histexpand.c \
		  $(srcdir)/histfile.c \
		  $(srcdir)/history.c \
		  $(srcdir)/histsearch.c \
		  $(srcdir)/input.c \
		  $(srcdir)/isearch.c \
		  $(srcdir)/keymaps.c \
		  $(srcdir)/kill.c \
		  $(srcdir)/macro.c \
		  $(srcdir)/mbutil.c \
		  $(srcdir)/misc.c \
		  $(srcdir)/nls.c \
		  $(srcdir)/parens.c \
		  $(srcdir)/parse-colors.c \
		  $(srcdir)/readline.c \
		  $(srcdir)/rltty.c \
		  $(srcdir)/savestring.c \
		  $(srcdir)/search.c \
		  $(srcdir)/shell.c \
		  $(srcdir)/signals.c \
		  $(srcdir)/terminal.c \
		  $(srcdir)/text.c \
		  $(srcdir)/tilde.c \
		  $(srcdir)/undo.c \
		  $(srcdir)/util.c \
		  $(srcdir)/vi_keymap.c \
		  $(srcdir)/vi_mode.c \
		  $(srcdir)/xfree.c \
		  $(srcdir)/xmalloc.c \


# The header files for this library.
HSOURCES	= \
		  $(srcdir)/ansi_stdlib.h \
		  $(srcdir)/chardefs.h \
		  $(srcdir)/colors.h \
		  $(srcdir)/histlib.h \
		  $(srcdir)/history.h \
		  $(srcdir)/keymaps.h \
		  $(srcdir)/parse-colors.h \
		  $(srcdir)/posixdir.h \
		  $(srcdir)/posixjmp.h \
		  $(srcdir)/posixstat.h \
		  $(srcdir)/readline.h \
		  $(srcdir)/rlconf.h \
		  $(srcdir)/rldefs.h \
		  $(srcdir)/rlmbutil.h \
		  $(srcdir)/rlprivate.h \
		  $(srcdir)/rlshell.h \
		  $(srcdir)/rlstdc.h \
		  $(srcdir)/rltty.h \
		  $(srcdir)/rltypedefs.h \
		  $(srcdir)/tcap.h \
		  $(srcdir)/tilde.h \
		  $(srcdir)/xmalloc.h \


HISTOBJ		= \
		  histexpand.o \
		  histfile.o \
		  history.o \
		  histsearch.o \
		  mbutil.o \
		  savestring.o \
		  shell.o \


TILDEOBJ	= tilde.o
COLORSOBJ	= colors.o parse-colors.o
OBJECTS		= \
		  $(COLORSOBJ) \
		  $(HISTOBJ) \
		  $(TILDEOBJ) \
		  bind.o \
		  callback.o \
		  compat.o \
		  complete.o \
		  display.o \
		  funmap.o \
		  input.o \
		  isearch.o \
		  keymaps.o \
		  kill.o \
		  macro.o \
		  misc.o \
		  nls.o \
		  parens.o \
		  readline.o \
		  rltty.o \
		  search.o \
		  signals.o \
		  terminal.o \
		  text.o \
		  undo.o \
		  util.o \
		  vi_mode.o \
		  xfree.o \
		  xmalloc.o \


# The texinfo files which document this library.
DOCSOURCE = doc/rlman.texinfo doc/rltech.texinfo doc/rluser.texinfo
DOCOBJECT = doc/readline.dvi
DOCSUPPORT = doc/Makefile
DOCUMENTATION = $(DOCSOURCE) $(DOCOBJECT) $(DOCSUPPORT)

SUPPORT = Makefile ChangeLog $(DOCSUPPORT) examples/[-a-z.]*

SOURCES  = $(CSOURCES) $(HSOURCES) $(DOCSOURCE)

THINGS_TO_TAR = $(SOURCES) $(SUPPORT)

INSTALLED_HEADERS = \
		  chardefs.h \
		  history.h \
		  keymaps.h \
		  readline.h \
		  rlconf.h \
		  rlstdc.h \
		  rltypedefs.h \
		  tilde.h \


##########################################################################

all: libreadline.a libhistory.a

libreadline.a: $(OBJECTS)
	@- $(RM) $@
	$(AR) $(ARFLAGS) $@ $(OBJECTS)
	- test -n "$(RANLIB)" && $(RANLIB) $@

libhistory.a: $(HISTOBJ) xmalloc.o xfree.o
	@- $(RM) $@
	$(AR) $(ARFLAGS) $@ $(HISTOBJ) xmalloc.o xfree.o
	- test -n "$(RANLIB)" && $(RANLIB) $@

documentation: force
	test -d doc || mkdir doc
	- cd doc && $(MAKE) $(BASH_MAKEFLAGS)

# Since tilde.c is shared between readline and bash, make sure we compile
# it with the right flags when it's built as part of readline
tilde.o: tilde.c
	rm -f $@
	$(CC) $(CCFLAGS) -DREADLINE_LIBRARY -c $(srcdir)/tilde.c

force:

install:
	@ echo "This version of the readline library should not be installed."

uninstall:
	@ echo "This version of the readline library should not be installed."

TAGS: force
	$(ETAGS) $(CSOURCES) $(HSOURCES)

tags: force
	$(CTAGS) $(CSOURCES) $(HSOURCES)

.PHONY: clean maintainer-clean distclean mostlyclean

mostlyclean: force
	$(RM) $(OBJECTS) *.a
	- cd doc && $(MAKE) $(BASH_MAKEFLAGS) $@

clean: mostlyclean
	- cd doc && $(MAKE) $(BASH_MAKEFLAGS) $@

distclean maintainer-clean: clean
	- cd doc && $(MAKE) $(BASH_MAKEFLAGS) $@
	$(RM) Makefile
	$(RM) TAGS tags

