srcdir = @srcdir@
VPATH = @srcdir@
topdir = @top_srcdir@

INSTALL = @INSTALL@
INSTALL_PROGRAM = @INSTALL_PROGRAM@
INSTALL_DATA = @INSTALL_DATA@

CC = @CC@
RANLIB = @RANLIB@
AR = @AR@
ARFLAGS = @ARFLAGS@
RM = rm -f
CP = cp
MV = mv

SHELL = @MAKE_SHELL@

PROFILE_FLAGS = @PROFILE_FLAGS@
ADDON_CFLAGS =

CFLAGS = @CFLAGS@
LOCAL_CFLAGS = @LOCAL_CFLAGS@
STYLE_CFLAGS = @STYLE_CFLAGS@
CPPFLAGS = @CPPFLAGS@
LDFLAGS = @LDFLAGS@ @LOCAL_LDFLAGS@

DEFS = @DEFS@
LOCAL_DEFS = @LOCAL_DEFS@

BASHINCDIR = ${topdir}/include
SUPPORT_SRC = $(topdir)/support/

INCLUDES = -I. \
	   -I../.. \
	   -I$(topdir) \
	   -I$(BASHINCDIR) \
	   -I$(topdir)/lib \


MKDEP = $(SUPPORT_SRC)mkdep
MKDEP_CC = $(CC)
MKDEP_OPTS = -c $(MKDEP_CC) -P -S "$(srcdir)" -T "$(topdir)"
MKDEP_CFLAGS = $(CCFLAGS)
MKDEP_CSOURCES = $(srcdir)/*.c # *.c

CCFLAGS = $(PROFILE_FLAGS) $(DEFS) $(LOCAL_DEFS) ${INCLUDES} $(CPPFLAGS) \
	  $(STYLE_CFLAGS) $(LOCAL_CFLAGS) $(CFLAGS) ${ADDON_CFLAGS}

# Here is a rule for making .o files from .c files that doesn't force
# the type of the machine (like -sun3) into the flags.
.c.o:
	@- $(RM) $@
	$(CC) -c $(CCFLAGS) $<

# The name of the library target.
LIBRARY_NAME = libglob.a

# The C code source files for this library.
CSOURCES = $(srcdir)/glob.c $(srcdir)/strmatch.c $(srcdir)/smatch.c \
	   $(srcdir)/gmisc.c \
	   $(srcdir)/xmbsrtowcs.c

LOOP_FILES = $(srcdir)/glob_loop.c $(srcdir)/gm_loop.c $(srcdir)/sm_loop.c

# The header files for this library.
HSOURCES = $(srcdir)/strmatch.h

OBJECTS = glob.o strmatch.o smatch.o xmbsrtowcs.o gmisc.o

# The texinfo files which document this library.
DOCSOURCE = doc/glob.texi
DOCOBJECT = doc/glob.dvi
DOCSUPPORT = doc/Makefile
DOCUMENTATION = $(DOCSOURCE) $(DOCOBJECT) $(DOCSUPPORT)

SUPPORT = Makefile ChangeLog $(DOCSUPPORT)

SOURCES  = $(CSOURCES) $(HSOURCES) $(DOCSOURCE)

THINGS_TO_TAR = $(SOURCES) $(SUPPORT)

######################################################################

all: $(LIBRARY_NAME)

$(LIBRARY_NAME): $(OBJECTS)
	@- $(RM) -f $@
	$(AR) $(ARFLAGS) $@ $(OBJECTS)
	- test -n "$(RANLIB)" && $(RANLIB) $@

what-tar:
	@ for file in $(THINGS_TO_TAR) ; do \
	    echo $(selfdir)$$file ; \
	  done

documentation: force
	- cd doc && $(MAKE) $(BASH_MAKEFLAGS)
force:

# The rule for 'includes' is written funny so that the if statement
# always returns TRUE unless there really was an error installing the
# include files.
install:

.PHONY: clean maintainer-clean distclean mostlyclean

mostlyclean:
	rm -f $(OBJECTS) $(LIBRARY_NAME)
	- cd doc && $(MAKE) $(BASH_MAKEFLAGS) $@

realclean distclean maintainer-clean: clean
	- cd doc && $(MAKE) $(BASH_MAKEFLAGS) $@
	$(RM) -f Makefile

clean: mostlyclean
	- cd doc && $(MAKE) $(BASH_MAKEFLAGS) $@

../../pathnames.h: ../../config.h ../../Makefile Makefile

../../config.h \
../../pathnames.h \
 :
	- cd $(@D) && $(MAKE) $(BASH_MAKEFLAGS) $(@F)

.PHONY: depends depend
depends depend Makefile:
	$(SHELL) $(MKDEP) $(MKDEP_OPTS) -- $(MKDEP_CFLAGS) $(MKDEP_CSOURCES)

