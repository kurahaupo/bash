srcdir = @srcdir@
VPATH = @srcdir@
topdir = @top_srcdir@

INSTALL = @INSTALL@
INSTALL_PROGRAM = @INSTALL_PROGRAM@
INSTALL_DATA = @INSTALL_DATA@

CC = @CC@
RANLIB = @RANLIB@
AR = @AR@
ARFLAGS = @ARFLAGS@
RM = rm -f
CP = cp
MV = mv

SHELL = @MAKE_SHELL@

PROFILE_FLAGS = @PROFILE_FLAGS@

CFLAGS = @CFLAGS@
LOCAL_CFLAGS = @LOCAL_CFLAGS@
STYLE_CFLAGS = @STYLE_CFLAGS@
CPPFLAGS = @CPPFLAGS@
LDFLAGS = @LDFLAGS@

DEFS = @DEFS@
LOCAL_DEFS = @LOCAL_DEFS@

LIBBUILD = ..

BASHINCDIR = ${topdir}/include
SUPPORT_SRC = $(topdir)/support/

INTL_LIBSRC = ${topdir}/lib/intl
INTL_BUILDDIR = ../intl
INTL_INC = @INTL_INC@
LIBINTL_H = @LIBINTL_H@

# Which malloc implementation?
MALLOC_TARGET = @MALLOC_TARGET@

INCLUDES = -I. \
	   -I$(srcdir) \
	   -I../.. \
	   -I$(topdir) \
	   $(INTL_INC) \
	   -I$(BASHINCDIR) \


MKDEP = $(SUPPORT_SRC)mkdep
MKDEP_CC = ${CC}
MKDEP_OPTS = -c ${MKDEP_CC} -P -S "$(srcdir)" -T "$(topdir)"
MKDEP_CFLAGS = ${CCFLAGS}
MKDEP_CSOURCES = $(srcdir)/*.c # *.c


CCFLAGS = ${PROFILE_FLAGS} ${INCLUDES} $(DEFS) $(LOCAL_DEFS) $(LOCAL_CFLAGS) \
	  $(CFLAGS) $(MALLOC_CFLAGS) $(STYLE_CFLAGS) $(CPPFLAGS)

.c.o:
	$(CC) $(CCFLAGS) -c $<

.s.o:
	$(CC) $(CCFLAGS) -c $<

MALLOC_SOURCE = malloc.c
STUB_SOURCE = stub.c

ALLOCA_SOURCE = alloca.c
ALLOCA_OBJECT = alloca.o

MALLOC_SRC = @MALLOC_SRC@

# set to alloca.o if we are using the C alloca in lib/malloc
ALLOCA = @ALLOCA@

MALLOC_OBJS = malloc.o $(ALLOCA) trace.o stats.o table.o watch.o
STUB_OBJS = $(ALLOCA) stub.o

.PHONY: malloc stubmalloc

all libmalloc.a: $(MALLOC_TARGET)

malloc: ${MALLOC_OBJS}
	@- ${RM} libmalloc.a
	${AR} ${ARFLAGS} libmalloc.a ${MALLOC_OBJS}
	- test -n "$(RANLIB)" && $(RANLIB) libmalloc.a

stubmalloc: ${STUB_OBJS}
	@- ${RM} libmalloc.a
	${AR} ${ARFLAGS} libmalloc.a ${STUB_OBJS}
	- test -n "$(RANLIB)" && $(RANLIB) libmalloc.a

alloca: ${ALLOCA}
	@- ${RM} libmalloc.a
	${AR} ${ARFLAGS} libmalloc.a ${ALLOCA}
	- test -n "$(RANLIB)" && $(RANLIB) libmalloc.a

alloca.o: $(srcdir)/$(ALLOCA_SOURCE)
	$(CC) $(CCFLAGS) -c $(srcdir)/$(ALLOCA_SOURCE)
	@- if test "$(ALLOCA_OBJECT)" != alloca.o ; then \
	    mv $(ALLOCA_OBJECT) alloca.o >/dev/null 2>&1 ; \
	   fi

.PHONY: clean maintainer-clean distclean mostlyclean

mostlyclean:
	$(RM) *.o libmalloc.a

clean: mostlyclean

distclean realclean maintainer-clean: clean
	$(RM) Makefile

.PHONY: depends depend
depends depend Makefile:
	$(SHELL) $(MKDEP) $(MKDEP_OPTS) -- $(MKDEP_CFLAGS) $(MKDEP_CSOURCES)

################################################################################
#####   MKDEP-CUT-HERE  #####

# This list was generated on Ubuntu GNU/Linux 1804, and should work on any
# typical GNU/Linux distribution.
#
# On other platforms you may need to uncomment some of the lines below, or use
# ‘support/mkdep’ to replace this entire list.

alloca.o: $(srcdir)/alloca.c
alloca.o: $(topdir)/config-bot.h
alloca.o: $(topdir)/config-top.h
alloca.o: ../../config.h
malloc.o: $(BASHINCDIR)/gettext.h
malloc.o: $(BASHINCDIR)/stdc.h
#malloc.o: $(LIBINTL_H)
malloc.o: $(srcdir)/imalloc.h
malloc.o: $(srcdir)/malloc.c
#malloc.o: $(srcdir)/mstats.h
#malloc.o: $(srcdir)/table.h
#malloc.o: $(srcdir)/watch.h
malloc.o: $(topdir)/bashintl.h
malloc.o: $(topdir)/bashtypes.h
malloc.o: $(topdir)/config-bot.h
malloc.o: $(topdir)/config-top.h
malloc.o: ../../config.h
#malloc.o: getpagesize.h
#malloc.o: malloc.c
memtest.o: $(BASHINCDIR)/ansi_stdlib.h
memtest.o: $(BASHINCDIR)/stdc.h
memtest.o: $(srcdir)/memtest.c
memtest.o: $(topdir)/bashansi.h
memtest.o: $(topdir)/xmalloc.h
sbrk.o: $(srcdir)/sbrk.c
sbrk.o: $(topdir)/config-bot.h
sbrk.o: $(topdir)/config-top.h
sbrk.o: ../../config.h
stats.o: $(BASHINCDIR)/gettext.h
#stats.o: $(LIBINTL_H)
stats.o: $(srcdir)/imalloc.h
#stats.o: $(srcdir)/mstats.h
stats.o: $(srcdir)/stats.c
stats.o: $(topdir)/bashintl.h
stats.o: $(topdir)/config-bot.h
stats.o: $(topdir)/config-top.h
stats.o: ../../config.h
#stats.o: stats.c
stub.o: $(srcdir)/stub.c
#stub.o: stub.c
table.o: $(BASHINCDIR)/gettext.h
#table.o: $(LIBINTL_H)
table.o: $(srcdir)/imalloc.h
table.o: $(srcdir)/table.c
table.o: $(srcdir)/table.h
table.o: $(topdir)/bashintl.h
table.o: $(topdir)/config-bot.h
table.o: $(topdir)/config-top.h
table.o: ../../config.h
trace.o: $(BASHINCDIR)/gettext.h
#trace.o: $(LIBINTL_H)
trace.o: $(srcdir)/imalloc.h
trace.o: $(srcdir)/trace.c
trace.o: $(topdir)/bashintl.h
trace.o: $(topdir)/config-bot.h
trace.o: $(topdir)/config-top.h
trace.o: ../../config.h
watch.o: $(BASHINCDIR)/gettext.h
#watch.o: $(LIBINTL_H)
watch.o: $(srcdir)/imalloc.h
watch.o: $(srcdir)/watch.c
#watch.o: $(srcdir)/watch.h
watch.o: $(topdir)/bashintl.h
watch.o: $(topdir)/config-bot.h
watch.o: $(topdir)/config-top.h
watch.o: ../../config.h
#xmalloc.o: $(BASHINCDIR)/ansi_stdlib.h
xmalloc.o: $(srcdir)/xmalloc.c
xmalloc.o: $(topdir)/config-bot.h
xmalloc.o: $(topdir)/config-top.h
xmalloc.o: ../../config.h
