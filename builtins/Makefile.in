PACKAGE = @PACKAGE_NAME@
PACKAGE_BUGREPORT = @PACKAGE_BUGREPORT@
PACKAGE_NAME = @PACKAGE_NAME@
PACKAGE_STRING = @PACKAGE_STRING@
PACKAGE_VERSION = @PACKAGE_VERSION@

#
SHELL = @MAKE_SHELL@
RANLIB = @RANLIB@
CC = @CC@
CC_FOR_BUILD = @CC_FOR_BUILD@
AR = @AR@
ARFLAGS = @ARFLAGS@
RM = rm -f
CP = cp

EXEEXT = @EXEEXT@

prefix = @prefix@

srcdir = @srcdir@
VPATH = @srcdir@
topdir = @top_srcdir@

datarootdir = @datarootdir@

includedir = @includedir@
datadir = @datadir@
localedir = @localedir@

loadablesdir = @loadablesdir@

# Support an alternate destination root directory for package building
DESTDIR =

INSTALL = @INSTALL@
INSTALL_DATA = @INSTALL_DATA@

SUPPORT_SRC = $(topdir)/support/

DEBUG = @DEBUG@

PROFILE_FLAGS = @PROFILE_FLAGS@
CFLAGS = @CFLAGS@
CFLAGS_FOR_BUILD = @CFLAGS_FOR_BUILD@ @CROSS_COMPILE@
STYLE_CFLAGS = @STYLE_CFLAGS@
CPPFLAGS = @CPPFLAGS@
CPPFLAGS_FOR_BUILD = @CPPFLAGS_FOR_BUILD@
LOCAL_CFLAGS = @LOCAL_CFLAGS@ ${DEBUG}
DEFS = @DEFS@
LOCAL_DEFS = @LOCAL_DEFS@

LIBS = @LIBS@
LDFLAGS = @LDFLAGS@ $(LOCAL_LDFLAGS) $(CFLAGS)
LDFLAGS_FOR_BUILD = @LDFLAGS_FOR_BUILD@ $(LOCAL_LDFLAGS) $(CFLAGS_FOR_BUILD)
LOCAL_LDFLAGS = @LOCAL_LDFLAGS@
LIBS_FOR_BUILD = @LIBS_FOR_BUILD@
#LIBS_FOR_BUILD = $(LIBS)

BASHINCDIR = ${topdir}/include

RL_INCLUDEDIR = @RL_INCLUDEDIR@

# xxx this is bad style
GLOB_LIBSRC = ${topdir}/lib/glob
HIST_LIBSRC = ${topdir}/lib/readline
RL_LIBSRC = ${topdir}/lib/readline
TILDE_LIBSRC = ${topdir}/lib/tilde

INTL_INC = @INTL_INC@
INTL_DEP = @INTL_DEP@
LIBINTL_H = @LIBINTL_H@

HELPDIR = @HELPDIR@

MKDIRS = ${topdir}/support/mkdirs

HELPFILES_TARGET = @HELPFILES_TARGET@

INCLUDES = -I. \
	   -I$(srcdir) \
	   -I.. \
	   -I$(topdir) \
	   -I../lib \
	   -I$(topdir)/lib \
	   @RL_INCLUDE@ \
	   $(INTL_INC) \
	   -I$(BASHINCDIR) \


MKDEP = $(SUPPORT_SRC)mkdep
MKDEP_CC = $(CC)
MKDEP_OPTS = -c "$(MKDEP_CC)" -P -S "$(srcdir)" -T "$(topdir)" \
		-R "alias.c=$(srcdir)/alias.def" \
		-R "bind.c=$(srcdir)/bind.def" \
		-R "break.c=$(srcdir)/break.def" \
		-R "builtin.c=$(srcdir)/builtin.def" \
		-R "caller.c=$(srcdir)/caller.def" \
		-R "cd.c=$(srcdir)/cd.def" \
		-R "colon.c=$(srcdir)/colon.def" \
		-R "command.c=$(srcdir)/command.def" \
		-R "complete.c=$(srcdir)/complete.def" \
		-R "declare.c=$(srcdir)/declare.def" \
		-R "echo.c=$(srcdir)/echo.def" \
		-R "enable.c=$(srcdir)/enable.def" \
		-R "eval.c=$(srcdir)/eval.def" \
		-R "exec.c=$(srcdir)/exec.def" \
		-R "exit.c=$(srcdir)/exit.def" \
		-R "fc.c=$(srcdir)/fc.def" \
		-R "fg_bg.c=$(srcdir)/fg_bg.def" \
		-R "getopts.c=$(srcdir)/getopts.def" \
		-R "hash.c=$(srcdir)/hash.def" \
		-R "help.c=$(srcdir)/help.def" \
		-R "history.c=$(srcdir)/history.def" \
		-R "jobs.c=$(srcdir)/jobs.def" \
		-R "kill.c=$(srcdir)/kill.def" \
		-R "let.c=$(srcdir)/let.def" \
		-R "mapfile.c=$(srcdir)/mapfile.def" \
		-R "printf.c=$(srcdir)/printf.def" \
		-R "pushd.c=$(srcdir)/pushd.def" \
		-R "read.c=$(srcdir)/read.def" \
		-R "reserved.c=$(srcdir)/reserved.def" \
		-R "return.c=$(srcdir)/return.def" \
		-R "set.c=$(srcdir)/set.def" \
		-R "setattr.c=$(srcdir)/setattr.def" \
		-R "shift.c=$(srcdir)/shift.def" \
		-R "shopt.c=$(srcdir)/shopt.def" \
		-R "source.c=$(srcdir)/source.def" \
		-R "suspend.c=$(srcdir)/suspend.def" \
		-R "test.c=$(srcdir)/test.def" \
		-R "times.c=$(srcdir)/times.def" \
