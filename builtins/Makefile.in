PACKAGE = @PACKAGE_NAME@
PACKAGE_BUGREPORT = @PACKAGE_BUGREPORT@
PACKAGE_NAME = @PACKAGE_NAME@
PACKAGE_STRING = @PACKAGE_STRING@
PACKAGE_VERSION = @PACKAGE_VERSION@

################################################################################
# Source and intermediate files
VPATH = @srcdir@
srcdir = @srcdir@/
srctop = @top_srcdir@/

bldtop = @BUILD_DIR@

EXEEXT = @EXEEXT@
prefix = @prefix@

################################################################################
# Where to install things
# Support an alternate destination root directory for package building
# (currently only for help files)
DESTDIR =

datarootdir = @datarootdir@

includedir = @includedir@
datadir = @datadir@
localedir = @localedir@

loadablesdir = @loadablesdir@

################################################################################
# Build tools

AR = @AR@
ARFLAGS = @ARFLAGS@
CC = @CC@
CC_FOR_BUILD = @CC_FOR_BUILD@
CP = cp
INSTALL = @INSTALL@
INSTALL_DATA = @INSTALL_DATA@
MKDEP = $(srctop)support/mkdep
MKDIRS = $(srctop)support/mkdirs
RANLIB = @RANLIB@
RM = rm -f
SHELL = @MAKE_SHELL@

################################################################################
# Externally set locations

INTL_INC = @INTL_INC@
INTL_DEP = @INTL_DEP@
LIBINTL_H = @LIBINTL_H@

################################################################################
# Compiler & linker settings

# Inclusion paths depend on where the source tree and build trees are...
INCLUDES = -I. -I.. \
	    @RL_INCLUDE@ \
	    -I$(srctop)include \
	    -I$(srctop)lib \
	    -I$(srctop) \
	    -I$(srcdir) \
	    $(INTL_INC)

PROFILE_FLAGS = @PROFILE_FLAGS@
CFLAGS = @CFLAGS@
CFLAGS_FOR_BUILD = @CFLAGS_FOR_BUILD@ @CROSS_COMPILE@
STYLE_CFLAGS = @STYLE_CFLAGS@
CPPFLAGS = @CPPFLAGS@
CPPFLAGS_FOR_BUILD = @CPPFLAGS_FOR_BUILD@
LOCAL_CFLAGS = @LOCAL_CFLAGS@ ${DEBUG}
DEFS = @DEFS@
LOCAL_DEFS = @LOCAL_DEFS@

LIBS = @LIBS@
LDFLAGS = @LDFLAGS@ $(LOCAL_LDFLAGS) $(CFLAGS)
LDFLAGS_FOR_BUILD = @LDFLAGS_FOR_BUILD@ $(LOCAL_LDFLAGS) $(CFLAGS_FOR_BUILD)
LOCAL_LDFLAGS = @LOCAL_LDFLAGS@
LIBS_FOR_BUILD = @LIBS_FOR_BUILD@
#LIBS_FOR_BUILD = $(LIBS)

RL_INCLUDEDIR = @RL_INCLUDEDIR@

INTL_LIBSRC = $(srctop)lib/intl
INTL_BUILDDIR = $(bldtop)/lib/intl
INTL_LIBDIR = ${INTL_BUILDDIR}
INTL_LIBRARY = ${INTL_BUILDDIR}/libintl.a

################################################################################
HELPDIR = $(DESTDIR)@HELPDIR@

HELPFILES_TARGET = @HELPFILES_TARGET@

BASE_CCFLAGS = ${PROFILE_FLAGS} $(DEFS) $(LOCAL_DEFS) $(SYSTEM_FLAGS) \
	 ${INCLUDES} $(STYLE_CFLAGS) $(LOCAL_CFLAGS)

CCFLAGS = ${ADDON_CFLAGS} $(BASE_CCFLAGS) $(CPPFLAGS) $(CFLAGS)

CCFLAGS_FOR_BUILD = $(BASE_CCFLAGS) $(CPPFLAGS_FOR_BUILD) $(CFLAGS_FOR_BUILD)

GCC_LINT_FLAGS = -Wall -Wshadow -Wpointer-arith -Wcast-qual \
		 -Wcast-align -Wstrict-prototypes -Wconversion \
		 -Wmissing-prototypes -Wtraditional -Wredundant-decls -pedantic

MKBUILTINS = mkbuiltins$(EXEEXT)
DIRECTDEFINE = -D $(srcdir)
HELPDIRDEFINE = @HELPDIRDEFINE@
HELPSTRINGS = @HELPSTRINGS@

# xxx this is bad style
RL_LIBSRC = $(srctop)lib/readline

.SUFFIXES:
.SUFFIXES: .def .c .o
# How to make a .o file from a .def file.
.def.o:
	@- $(RM) $@ $*.c
	./$(MKBUILTINS) $(DIRECTDEFINE) $<
	$(CC) -c $(CCFLAGS) $*.c || { $(RM) $*.c ; false ; }
	@- $(RM) $*.c

# How to make a .c file from a .def file.
.def.c:
	@- $(RM) $@
	./$(MKBUILTINS) $(DIRECTDEFINE) $<

# default rule for making a .o file from a .c file
.c.o:
	@- $(RM) $@
	$(CC) -c $(CCFLAGS) $<

DEFSRC		= \
		  $(srcdir)alias.def \
		  $(srcdir)bind.def \
		  $(srcdir)break.def \
		  $(srcdir)builtin.def \
		  $(srcdir)caller.def \
		  $(srcdir)cd.def \
		  $(srcdir)colon.def \
		  $(srcdir)command.def \
		  $(srcdir)complete.def \
		  $(srcdir)declare.def \
		  $(srcdir)echo.def \
		  $(srcdir)enable.def \
		  $(srcdir)eval.def \
		  $(srcdir)exec.def \
		  $(srcdir)exit.def \
		  $(srcdir)fc.def \
		  $(srcdir)fg_bg.def \
		  $(srcdir)getopts.def \
		  $(srcdir)hash.def \
		  $(srcdir)help.def \
		  $(srcdir)history.def \
		  $(srcdir)jobs.def \
		  $(srcdir)kill.def \
		  $(srcdir)let.def \
		  $(srcdir)mapfile.def \
		  $(srcdir)printf.def \
		  $(srcdir)pushd.def \
		  $(srcdir)read.def \
		  $(srcdir)reserved.def \
		  $(srcdir)return.def \
		  $(srcdir)set.def \
		  $(srcdir)setattr.def \
		  $(srcdir)shift.def \
		  $(srcdir)shopt.def \
		  $(srcdir)source.def \
		  $(srcdir)suspend.def \
		  $(srcdir)test.def \
		  $(srcdir)times.def \
		  $(srcdir)trap.def \
		  $(srcdir)type.def \
		  $(srcdir)ulimit.def \
		  $(srcdir)umask.def \
		  $(srcdir)wait.def \


STATIC_SOURCE	= \
		  bashgetopt.c \
		  common.c \
		  evalfile.c \
		  evalstring.c \
		  getopt.c \
		  getopt.h \


OFILES		= \
		  alias.o \
		  bashgetopt.o \
		  bind.o \
		  break.o \
		  builtin.o \
		  builtins.o \
		  caller.o \
		  cd.o \
		  colon.o \
		  command.o \
		  common.o \
		  complete.o \
		  declare.o \
		  echo.o \
		  enable.o \
		  eval.o \
		  evalfile.o \
		  evalstring.o \
		  exec.o \
		  exit.o \
		  fc.o \
		  fg_bg.o \
		  getopt.o \
		  getopts.o \
		  hash.o \
		  help.o \
		  history.o \
		  jobs.o \
		  kill.o \
		  let.o \
		  mapfile.o \
		  printf.o \
		  pushd.o \
		  read.o \
		  return.o \
		  set.o \
		  setattr.o \
		  shift.o \
		  shopt.o \
		  source.o \
		  suspend.o \
		  test.o \
		  times.o \
		  trap.o \
		  type.o \
		  ulimit.o \
		  umask.o \
		  wait.o \


CREATED_FILES	= \
		  builtext.h \
		  builtins.c \
		  pipesize.h \
		  psize.aux \
		  tmpbuiltins.c \
		  tmpbuiltins.h \


CREATED_OBJECTS	= \
		  gen-helpfiles.o \
		  mkbuiltins.o \
		  tmpbuiltins.o \


all: $(MKBUILTINS) libbuiltins.a $(HELPFILES_TARGET)
targets: libbuiltins.a $(HELPFILES_TARGET)

libbuiltins.a: $(MKBUILTINS) $(OFILES) builtins.o
	@- $(RM) $@
	$(AR) $(ARFLAGS) $@ $(OFILES)
	-$(RANLIB) $@

tmpbuiltins.c tmpbuiltins.h:	$(MKBUILTINS) $(DEFSRC)
	./$(MKBUILTINS) \
		-externfile tmpbuiltins.h \
		-structfile tmpbuiltins.c \
		-noproduction -nofunctions \
		$(DIRECTDEFINE) $(HELPSTRINGS) $(DEFSRC)

gen-helpfiles.o: ../config.h
gen-helpfiles.o: gen-helpfiles.c
	@- $(RM) $@
	$(CC_FOR_BUILD) -c $(CCFLAGS_FOR_BUILD) $<

gen-helpfiles:	tmpbuiltins.o gen-helpfiles.o
	$(CC_FOR_BUILD) $(LDFLAGS_FOR_BUILD) -o $@ gen-helpfiles.o tmpbuiltins.o $(LIBS_FOR_BUILD)

builtext.h builtins.c: $(MKBUILTINS) $(DEFSRC)
	@RECPID=$$$$ ; \
	NEW_BUILTEXT=builtext-$$RECPID.h NEW_BUILTINS=builtins-$$RECPID.c ; \
	./$(MKBUILTINS) -externfile $$NEW_BUILTEXT \
	    -includefile builtext.h \
	    -structfile $$NEW_BUILTINS \
	    -noproduction $(DIRECTDEFINE) $(HELPDIRDEFINE) $(HELPSTRINGS) $(DEFSRC) ; \
	if cmp -s $$NEW_BUILTEXT builtext.h 2>/dev/null; then \
		$(RM) $$NEW_BUILTEXT; \
	else \
		mv $$NEW_BUILTEXT builtext.h; \
	fi ; \
	if cmp -s $$NEW_BUILTINS builtins.c 2>/dev/null; then \
		$(RM) $$NEW_BUILTINS ; \
	else \
		mv $$NEW_BUILTINS builtins.c; \
	fi

.PHONY: helpdoc
helpdoc:	gen-helpfiles
	./gen-helpfiles ${HELPDIRDEFINE}

.PHONY: install-help
install-help:	$(HELPFILES_TARGET)
	@-if test -n "${HELPDIR}" && test -d helpfiles ; then \
		test -d ${HELPDIR} || ${SHELL} ${MKDIRS} $(HELPDIR) ;\
		( for f in helpfiles/*; do \
			echo installing $$f; \
			${INSTALL_DATA} $$f $(HELPDIR); \
		  done; ) ; \
	fi

.PHONY: install
install:	@HELPINSTALL@

mkbuiltins.o: ../config.h
mkbuiltins.o: mkbuiltins.c
	@- $(RM) $@
	$(CC_FOR_BUILD) -c $(CCFLAGS_FOR_BUILD) $<

mkbuiltins$(EXEEXT): mkbuiltins.o
	$(CC_FOR_BUILD) $(LDFLAGS_FOR_BUILD) -o $(MKBUILTINS) mkbuiltins.o $(LIBS_FOR_BUILD)

pipesize.h:	psize.aux
	$(SHELL) $(srcdir)psize.sh > $@

# Technically this is wrong; the pipe size should be for the target system,
# not the build host.
psize.aux:	psize.c
	$(CC_FOR_BUILD) $(CCFLAGS_FOR_BUILD) ${LDFLAGS_FOR_BUILD} -o $@ $(srcdir)psize.c

.PHONY: documentation
documentation: builtins.texi

builtins.texi: $(MKBUILTINS)
	./$(MKBUILTINS) -documentonly $(DEFSRC)

.PHONY: clean
clean:
	$(RM) $(OFILES) $(CREATED_FILES) libbuiltins.a
	$(RM) $(MKBUILTINS) gen-helpfiles $(CREATED_OBJECTS)
	-test -d helpfiles && $(RM) -r helpfiles

.PHONY: mostlyclean
mostlyclean:
	$(RM) $(OFILES) libbuiltins.a

.PHONY: distclean maintainer-clean
distclean maintainer-clean: clean
	$(RM) Makefile

$(OFILES):	$(MKBUILTINS) ../config.h

../version.h: ../config.h ../Makefile Makefile
	-( cd .. && ${MAKE} ${BASH_MAKEFLAGS} version.h )

# maintainer special - for now
.PHONY: po
po:	builtins.c
	xgettext -L C -o $(srctop)po/builtins.pot --keyword='N_' builtins.c 2>/dev/null

${LIBINTL_H}:
	@echo making $@ in ${INTL_BUILDDIR}
	@ cd ${INTL_BUILDDIR} && \
		$(MAKE) $(BASH_MAKEFLAGS) libintl.h

.PHONY: depends depend
depends depend: $(MKBUILTINS) builtext.h pipesize.h tmpbuiltins.h
	./$(MKBUILTINS) $(DIRECTDEFINE) $(srcdir)*.def
	sh $(MKDEP) -c "$(CC)" -P -S "$(srcdir)" -T "$(srctop)" -- $(CCFLAGS) $(srcdir)*.c *.c

# dependencies

bind.o: ${LIBINTL_H}
break.o: ${LIBINTL_H}
caller.o: ${LIBINTL_H}
cd.o: ${LIBINTL_H}
common.c: ${LIBINTL_H}
complete.o: ${LIBINTL_H}
declare.o: ${LIBINTL_H}
enable.o: ${LIBINTL_H}
evalfile.c: ${LIBINTL_H}
exec.o: ${LIBINTL_H}
exit.o: ${LIBINTL_H}
fc.o: ${LIBINTL_H}
fg_bg.o: ${LIBINTL_H}
getopt.c: ${LIBINTL_H}
hash.o: ${LIBINTL_H}
help.o: ${LIBINTL_H}
history.o: ${LIBINTL_H}
jobs.o: ${LIBINTL_H}
kill.o: ${LIBINTL_H}
let.o: ${LIBINTL_H}
mapfile.o: ${LIBINTL_H}
mkbuiltins.o: ${LIBINTL_H}
printf.o: ${LIBINTL_H}
pushd.o: ${LIBINTL_H}
read.o: ${LIBINTL_H}
return.o: ${LIBINTL_H}
set.o: ${LIBINTL_H}
setattr.o: ${LIBINTL_H}
shift.o: ${LIBINTL_H}
shopt.o: ${LIBINTL_H}
source.o: ${LIBINTL_H}
suspend.o: ${LIBINTL_H}
type.o: ${LIBINTL_H}
ulimit.o: ${LIBINTL_H}
umask.o: ${LIBINTL_H}

